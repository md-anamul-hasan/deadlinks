<Window x:Class="DeadLinks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeadLinks.ViewModels"
        xmlns:ctrl="clr-namespace:DeadLinks.Controls"
        xmlns:theme="clr-namespace:Mdah.Theming"
        mc:Ignorable="d"
        Title="DeadLinks"
        Icon="Assets/icon.ico"
        Height="740" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource Font.UI}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="KvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBase}"
            BorderBrush="{DynamicResource SurfaceBorderStrong}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <ctrl:TitleBar Grid.Row="0"/>

            <Grid Grid.Row="1" x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── Navigation ───────── -->
                <Border Background="{DynamicResource SurfaceOverlay}" Padding="12,16,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Scan"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Check}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="History"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntToRadioBool}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource Svg.Info}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="How it works"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <theme:ThemeToggleButton Margin="0,0,0,6"/>
                        <!-- Open source link -->
                        <Button Command="{Binding OpenRepositoryCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="Open the project on GitHub">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceInteractive}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccess}"/>
                                    <TextBlock Text="Free and open source" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AppVersion, StringFormat=v{0} · MIT · GitHub}" Style="{StaticResource Label}" Margin="15,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBorder}"/>

                <!-- ───────── Content ───────── -->
                <Grid Grid.Column="2" Background="{DynamicResource SurfaceBase}">
                        <!-- ═════ SCAN ═════ -->
                        <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=0}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32">
                            <StackPanel MaxWidth="980">
                                <TextBlock Text="Find dead shortcuts" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20"
                                           Text="DeadLinks looks for shortcuts and links whose target no longer exists: leftovers of uninstalled programs on the desktop, in the Start menu and on the taskbar, and in any folder you add. You review the list first; nothing is removed until you press Remove."/>

                                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Where to look" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Locations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,6" ToolTip="{Binding Path}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                                            <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Label}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Add folder…" Command="{Binding AddFolderCommand}" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Scan" Command="{Binding ScanCommand}" MinWidth="96"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisConverter}}"/>

                                <Grid Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Select dead" Command="{Binding SelectDeadCommand}" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,16,0"/>
                                        <CheckBox IsChecked="{Binding ShowAll}" Content="Also list shortcuts that are fine or not checkable" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Remove selected" Command="{Binding RemoveCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                                                            <Run Text="Points to: "/><Run Text="{Binding TargetText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Item.StatusText}" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Item.Status}" Value="TargetMissing"><Setter Property="Foreground" Value="{DynamicResource StatusError}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Item.Status}" Value="Unavailable"><Setter Property="Foreground" Value="{DynamicResource StatusWarning}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Item.Status}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource StatusSuccess}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Item.KindText}" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Item.Note}" Style="{StaticResource Label}" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding ShowEmptyText, Converter={StaticResource BoolToVisConverter}}"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <!-- ═════ HISTORY ═════ -->
                        <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=1}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="History" Style="{StaticResource PageTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,18"
                                           Text="Every removal keeps a copy of the shortcuts it removed. Press Restore to put a batch back; files that already exist again are left alone. Shortcuts are also in the Recycle Bin."/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Open the log and backup folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Padding="18,12">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Content="Restore" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nothing has been removed yet." Style="{StaticResource Muted}"
                                           Visibility="{Binding HasHistory, Converter={StaticResource InvertedBoolToVisConverter}}"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <!-- ═════ HOW IT WORKS ═════ -->
                        <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVis}, ConverterParameter=2}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,26,32,32">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="How it works" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource Panel}" Margin="0,18,0,12"><StackPanel>
                                    <TextBlock Text="What is a dead shortcut" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="A shortcut (.lnk), an internet shortcut (.url) to a local file, or a symbolic link or junction whose target no longer exists on a drive that is connected."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="What is never removed on its own" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Shortcuts on a disconnected drive or network share (they may work again later), Microsoft Store apps, system and installer shortcuts, web addresses and anything DeadLinks cannot read are listed as not checkable or offline and are never ticked for you."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="You see the list and confirm before anything is removed. Shortcuts go to the Recycle Bin and a copy is kept, so Restore on the History page puts them back. Locations that need administrator rights are skipped with a message; DeadLinks never asks for elevation."/>
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}"><StackPanel>
                                    <TextBlock Text="Free and private" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="DeadLinks is free and open source (MIT). It makes no network connections: nothing is sent anywhere, and there is no account, licence key or telemetry."/>
                                </StackPanel></Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Toast -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" MaxWidth="720" CornerRadius="10" Padding="16,11"
                                Background="{DynamicResource SurfaceInteractive}" BorderBrush="{DynamicResource SurfaceBorderStrong}" BorderThickness="1"
                                Visibility="{Binding IsStatusBannerVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusInfo}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Success"><Setter Property="Fill" Value="{DynamicResource StatusSuccess}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource StatusWarning}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBannerType}" Value="Error"><Setter Property="Fill" Value="{DynamicResource StatusError}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusBannerMessage}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissBannerCommand}" Content="✕" ToolTip="Dismiss" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

            </Grid>

            <ctrl:StatusBar Grid.Row="2"/>
        </Grid>
    </Border>
</Window>
