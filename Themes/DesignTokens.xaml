<!--
  SHARED DESIGN TOKENS: one file for every Mdah desktop tool (D048).
  The WDM palette; canonical copy was 08_templates/DesignTokens.xaml; the copy inside each app must be byte-identical
  (checked by 09_tools/validate_catalog.py). Change tokens in the canonical file, then copy it.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════════════════════════════════════════════════
         SURFACE COLORS
    ══════════════════════════════════════════════════════════ -->
    <Color x:Key="c.SurfaceBase">#0E1117</Color>
    <Color x:Key="c.SurfaceOverlay">#12161D</Color>
    <Color x:Key="c.SurfaceRaised">#161B22</Color>
    <Color x:Key="c.SurfaceSunken">#0F1319</Color>
    <Color x:Key="c.SurfaceInteractive">#222A35</Color>
    <Color x:Key="c.SurfaceSelected">#1E2F52</Color>
    <Color x:Key="c.SurfaceBorder">#262D38</Color>
    <Color x:Key="c.SurfaceBorderStrong">#3A4452</Color>

    <SolidColorBrush x:Key="SurfaceBase"         Color="{StaticResource c.SurfaceBase}"/>
    <SolidColorBrush x:Key="SurfaceOverlay"      Color="{StaticResource c.SurfaceOverlay}"/>
    <SolidColorBrush x:Key="SurfaceRaised"       Color="{StaticResource c.SurfaceRaised}"/>
    <SolidColorBrush x:Key="SurfaceSunken"       Color="{StaticResource c.SurfaceSunken}"/>
    <SolidColorBrush x:Key="SurfaceInteractive"  Color="{StaticResource c.SurfaceInteractive}"/>
    <SolidColorBrush x:Key="SurfaceSelected"     Color="{StaticResource c.SurfaceSelected}"/>
    <SolidColorBrush x:Key="SurfaceBorder"       Color="{StaticResource c.SurfaceBorder}"/>
    <SolidColorBrush x:Key="SurfaceBorderStrong" Color="{StaticResource c.SurfaceBorderStrong}"/>

    <!-- ══════════════════════════════════════════════════════════
         ACCENT / BRAND COLORS
    ══════════════════════════════════════════════════════════ -->
    <Color x:Key="c.AccentPrimary">#4C8DFF</Color>
    <Color x:Key="c.AccentPrimaryHover">#6BA0FF</Color>
    <Color x:Key="c.AccentPrimaryMuted">#184C8DFF</Color>
    <Color x:Key="c.AccentForge">#F97316</Color>
    <Color x:Key="c.AccentForgeHover">#FB923C</Color>
    <Color x:Key="c.AccentForgeMuted">#15F97316</Color>

    <Color x:Key="c.AccentViolet">#8B5CF6</Color>
    <Color x:Key="c.AccentVioletMuted">#158B5CF6</Color>
    <SolidColorBrush x:Key="AccentViolet"      Color="{StaticResource c.AccentViolet}"/>
    <SolidColorBrush x:Key="AccentVioletMuted" Color="{StaticResource c.AccentVioletMuted}"/>

    <SolidColorBrush x:Key="AccentPrimary"      Color="{StaticResource c.AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="{StaticResource c.AccentPrimaryHover}"/>
    <SolidColorBrush x:Key="AccentPrimaryMuted" Color="{StaticResource c.AccentPrimaryMuted}"/>
    <SolidColorBrush x:Key="AccentForge"        Color="{StaticResource c.AccentForge}"/>
    <SolidColorBrush x:Key="AccentForgeHover"   Color="{StaticResource c.AccentForgeHover}"/>
    <SolidColorBrush x:Key="AccentForgeMuted"   Color="{StaticResource c.AccentForgeMuted}"/>

    <!-- ══════════════════════════════════════════════════════════
         SEMANTIC STATUS COLORS
    ══════════════════════════════════════════════════════════ -->
    <Color x:Key="c.StatusError">#F87171</Color>
    <Color x:Key="c.StatusErrorMuted">#18F87171</Color>
    <Color x:Key="c.StatusWarning">#FBBF24</Color>
    <Color x:Key="c.StatusWarningMuted">#18FBBF24</Color>
    <Color x:Key="c.StatusSuccess">#4ADE80</Color>
    <Color x:Key="c.StatusSuccessMuted">#184ADE80</Color>
    <Color x:Key="c.StatusInfo">#4C8DFF</Color>
    <Color x:Key="c.StatusInfoMuted">#184C8DFF</Color>

    <SolidColorBrush x:Key="StatusError"        Color="{StaticResource c.StatusError}"/>
    <SolidColorBrush x:Key="StatusErrorMuted"   Color="{StaticResource c.StatusErrorMuted}"/>
    <SolidColorBrush x:Key="StatusWarning"      Color="{StaticResource c.StatusWarning}"/>
    <SolidColorBrush x:Key="StatusWarningMuted" Color="{StaticResource c.StatusWarningMuted}"/>
    <SolidColorBrush x:Key="StatusSuccess"      Color="{StaticResource c.StatusSuccess}"/>
    <SolidColorBrush x:Key="StatusSuccessMuted" Color="{StaticResource c.StatusSuccessMuted}"/>
    <SolidColorBrush x:Key="StatusInfo"         Color="{StaticResource c.StatusInfo}"/>
    <SolidColorBrush x:Key="StatusInfoMuted"    Color="{StaticResource c.StatusInfoMuted}"/>

    <!-- ══════════════════════════════════════════════════════════
         TEXT COLORS
    ══════════════════════════════════════════════════════════ -->
    <Color x:Key="c.TextPrimary">#E6EAF0</Color>
    <Color x:Key="c.TextSecondary">#B4BECC</Color>
    <Color x:Key="c.TextTertiary">#8091A6</Color>
    <Color x:Key="c.TextInverse">#0B1220</Color>
    <Color x:Key="c.TextLink">#6BA0FF</Color>

    <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource c.TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource c.TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="{StaticResource c.TextTertiary}"/>
    <SolidColorBrush x:Key="TextInverse"   Color="{StaticResource c.TextInverse}"/>
    <SolidColorBrush x:Key="TextLink"      Color="{StaticResource c.TextLink}"/>

    <!-- ══════════════════════════════════════════════════════════
         WINDOW CHROME & OVERLAYS (Windows 11 caption buttons, dialog scrim)
    ══════════════════════════════════════════════════════════ -->
    <Color x:Key="c.CaptionHover">#22FFFFFF</Color>
    <Color x:Key="c.CaptionPressed">#33FFFFFF</Color>
    <Color x:Key="c.CaptionCloseHover">#C42B1C</Color>
    <Color x:Key="c.CaptionClosePressed">#A82315</Color>
    <Color x:Key="c.Scrim">#B3000000</Color>
    <SolidColorBrush x:Key="CaptionHover"        Color="{StaticResource c.CaptionHover}"/>
    <SolidColorBrush x:Key="CaptionPressed"      Color="{StaticResource c.CaptionPressed}"/>
    <SolidColorBrush x:Key="CaptionCloseHover"   Color="{StaticResource c.CaptionCloseHover}"/>
    <SolidColorBrush x:Key="CaptionClosePressed" Color="{StaticResource c.CaptionClosePressed}"/>
    <SolidColorBrush x:Key="Scrim"               Color="{StaticResource c.Scrim}"/>

    <!-- ══════════════════════════════════════════════════════════
         TYPOGRAPHY (Windows 11 Variable Font Hierarchy)
    ══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <sys:Double x:Key="FontSize.Title">18</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Hero">28</sys:Double>

    <!-- ══════════════════════════════════════════════════════════
         RADII & SPACING DIMENSIONS
    ══════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">8</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="Radius.Full">4</CornerRadius>

    <Thickness x:Key="Padding.Card">16</Thickness>
    <Thickness x:Key="Padding.Button">14,8</Thickness>
    <Thickness x:Key="Padding.ButtonSm">10,5</Thickness>

    <sys:Double x:Key="Btn.HeightSm">28</sys:Double>
    <sys:Double x:Key="Btn.HeightMd">34</sys:Double>
</ResourceDictionary>
